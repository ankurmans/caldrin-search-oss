# Local development values. Never commit a filled-in copy.
# Provider keys are saved per workspace in the app (Settings), not here.

# password: the app's own accounts; the first visitor creates the administrator.
# cloudflare_access: identity comes from Cloudflare Access (set TEAM_DOMAIN and POLICY_AUD).
# local_noauth: a fixed local administrator. Loopback only.
# AUTH_MODE=password
# BETTER_AUTH_URL=http://127.0.0.1:4334
# BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional Google Search Console and Analytics (see docs/SELF_HOSTING_GOOGLE_*.md).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional operator-owned Google Maps Map Tiles key for Local SEO.
# GOOGLE_MAPS_API_KEY=
